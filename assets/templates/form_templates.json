[
  {
    "id": "teins_visita_v1",
    "name": "Formato Visita Técnica TEINS",
    "visit_type": "general",
    "version": 1,
    "sections": [
      {
        "id": "datos_servicio",
        "title": "Datos del Servicio",
        "order": 0,
        "fields": [
          {"id": "cliente", "type": "text", "label": "Cliente", "required": true},
          {"id": "nit", "type": "text", "label": "NIT", "required": false},
          {"id": "orden_servicio", "type": "text", "label": "Orden de Servicio", "required": false},
          {"id": "direccion", "type": "text", "label": "Dirección", "required": true},
          {"id": "ciudad", "type": "text", "label": "Ciudad", "required": false},
          {"id": "sede", "type": "text", "label": "Sede", "required": false},
          {"id": "solicitante", "type": "text", "label": "Solicitante", "required": false},
          {"id": "telefono", "type": "text", "label": "Teléfono", "required": false},
          {"id": "fecha_servicio", "type": "date", "label": "Fecha de Servicio", "required": true},
          {"id": "hora_inicio", "type": "time", "label": "Hora Inicio", "required": true},
          {"id": "hora_final", "type": "time", "label": "Hora Final", "required": false}
        ]
      },
      {
        "id": "sistema_revisado",
        "title": "Sistema Revisado",
        "order": 1,
        "fields": [
          {
            "id": "sistemas",
            "type": "multiSelect",
            "label": "Sistema(s) revisado(s)",
            "required": true,
            "options": ["Control Acceso", "CCTV", "UPS", "Alarma", "Red Datos", "Red Energía", "Otro"]
          },
          {"id": "sistema_otro_descripcion", "type": "text", "label": "Descripción del otro sistema", "required": false}
        ]
      },
      {
        "id": "diagnostico",
        "title": "Diagnóstico Técnico",
        "order": 2,
        "fields": [
          {"id": "estado_inicial", "type": "textarea", "label": "Estado Inicial", "required": true, "hint": "Describe el estado en que se encontró el equipo/sistema"},
          {"id": "diagnostico", "type": "textarea", "label": "Diagnóstico", "required": true, "hint": "Describe el diagnóstico realizado"},
          {"id": "correccion", "type": "textarea", "label": "Corrección", "required": false, "hint": "Describe la corrección aplicada"}
        ]
      },
      {
        "id": "resultado",
        "title": "Resultado del Servicio",
        "order": 3,
        "fields": [
          {
            "id": "solucionado",
            "type": "select",
            "label": "Estado de la solución",
            "required": true,
            "options": ["Totalmente solucionado", "Parcialmente solucionado", "No solucionado", "Solucionado remotamente", "Reprogramar visita"]
          },
          {"id": "se_emplearon_materiales", "type": "boolean", "label": "¿Se emplearon materiales o equipos?", "required": true},
          {"id": "descripcion_materiales", "type": "textarea", "label": "Descripción de materiales/equipos empleados", "required": false, "hint": "Cantidad, referencia, modelo, serial, etc."}
        ]
      },
      {
        "id": "observaciones_adicionales",
        "title": "Observaciones Adicionales",
        "order": 4,
        "fields": [
          {"id": "observaciones_adicionales", "type": "textarea", "label": "Observaciones adicionales", "required": false},
          {"id": "nombre_tecnico", "type": "text", "label": "Nombre del técnico que asistió", "required": true},
          {"id": "nombre_acompanante", "type": "text", "label": "Nombre acompañante (cliente)", "required": false},
          {"id": "nombre_supervisor", "type": "text", "label": "Supervisado/validado por", "required": false}
        ]
      }
    ]
  },
  {
    "id": "ups_cdp_v1",
    "name": "Informe Técnico UPS (CDP)",
    "visit_type": "ups",
