        "order": 1,
        "fields": [
          {"id": "velocidad_contratada", "type": "text", "label": "Velocidad contratada", "required": false},
          {"id": "velocidad_real_bajada", "type": "decimal", "label": "Velocidad real bajada (Mbps)", "required": false, "unit": "Mbps"},
          {"id": "velocidad_real_subida", "type": "decimal", "label": "Velocidad real subida (Mbps)", "required": false, "unit": "Mbps"},
          {"id": "latencia", "type": "decimal", "label": "Latencia (ms)", "required": false, "unit": "ms"},
          {"id": "proveedor", "type": "text", "label": "Proveedor de internet", "required": false}
        ]
      },
      {
        "id": "observaciones",
        "title": "Observaciones",
        "order": 2,
        "fields": [
          {"id": "problemas_detectados", "type": "textarea", "label": "Problemas detectados", "required": false},
          {"id": "observaciones_tecnicas", "type": "textarea", "label": "Observaciones técnicas", "required": false},
          {"id": "requiere_intervencion", "type": "boolean", "label": "¿Requiere intervención?", "required": true}
        ]
      }
    ]
  }
