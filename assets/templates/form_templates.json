          {"id": "os_numero", "type": "text", "label": "O.S. No.", "required": false},
          {
            "id": "tipo_servicio",
            "type": "multiSelect",
            "label": "Tipo de Servicio",
            "required": true,
            "options": ["Instalación", "Overhaul", "Correctivo", "Preventivo", "Cambio Baterías"]
          },
          {"id": "cliente", "type": "text", "label": "Cliente", "required": true},
          {"id": "fecha", "type": "date", "label": "Fecha", "required": true},
          {"id": "ciudad", "type": "text", "label": "Ciudad", "required": false},
          {"id": "oficina", "type": "text", "label": "Oficina", "required": false},
          {"id": "encargado", "type": "text", "label": "Encargado", "required": false},
          {"id": "telefono", "type": "text", "label": "Teléfono", "required": false},
          {"id": "ingeniero_tecnico", "type": "text", "label": "Ingeniero/Técnico", "required": false}
        ]
      },
      {
        "id": "identificacion_equipo",
        "title": "Identificación del Equipo",
        "order": 1,
        "fields": [
          {"id": "capacidad", "type": "text", "label": "Capacidad", "required": false},
          {"id": "marca", "type": "text", "label": "Marca", "required": false},
          {"id": "modelo", "type": "text", "label": "Modelo", "required": false},
          {"id": "serial", "type": "text", "label": "Serial", "required": false},
          {"id": "no_sim_card", "type": "text", "label": "No. de SIM Card", "required": false}
        ]
      },
      {
        "id": "diagnostico",
        "title": "Diagnóstico",
        "order": 2,
        "fields": [
          {"id": "dano_reportado", "type": "textarea", "label": "Daño reportado por el cliente", "required": false},
          {"id": "estado_inicial", "type": "textarea", "label": "Estado inicial del equipo", "required": false}
        ]
      },
      {
        "id": "estado_conexion",
        "title": "Estado de la Conexión",
        "order": 3,
        "fields": [
          {"id": "tablero_electrico", "type": "text", "label": "Tablero Eléctrico", "required": false},
          {"id": "tomas_clavijas", "type": "text", "label": "Tomas y clavijas", "required": false},
          {"id": "barrajes", "type": "text", "label": "Barrajes", "required": false},
          {"id": "breakers", "type": "text", "label": "Breakers", "required": false},
          {"id": "bypass_externo", "type": "text", "label": "Bypass Externo", "required": false},
          {"id": "rack_baterias", "type": "text", "label": "Rack de Baterías", "required": false}
        ]
      },
      {
        "id": "acometida",
        "title": "Acometida",
        "order": 4,
        "fields": [
          {"id": "voltaje_f1_fnac", "type": "decimal", "label": "Voltaje F-NAC F1 (V)", "required": false, "unit": "V"},
          {"id": "voltaje_f2_fnac", "type": "decimal", "label": "Voltaje F-NAC F2 (V)", "required": false, "unit": "V"},
          {"id": "voltaje_f3_fnac", "type": "decimal", "label": "Voltaje F-NAC F3 (V)", "required": false, "unit": "V"},
          {"id": "corriente_entrada_f1", "type": "decimal", "label": "Corriente entrada F1 (A)", "required": false, "unit": "A"},
          {"id": "corriente_entrada_f2", "type": "decimal", "label": "Corriente entrada F2 (A)", "required": false, "unit": "A"},
          {"id": "corriente_entrada_f3", "type": "decimal", "label": "Corriente entrada F3 (A)", "required": false, "unit": "A"},
          {"id": "n_tac", "type": "decimal", "label": "N-TAC (V)", "required": false, "unit": "V"},
          {"id": "f_f", "type": "decimal", "label": "F-F (V)", "required": false, "unit": "V"},
          {"id": "neutro_aislado", "type": "boolean", "label": "Neutro Aislado", "required": false},
          {"id": "hz", "type": "decimal", "label": "HZ", "required": false, "unit": "Hz"}
        ]
      },
      {
        "id": "pruebas_equipo",
        "title": "Pruebas del Equipo",
        "order": 5,
        "fields": [
          {"id": "voltaje_flotacion_f1", "type": "decimal", "label": "Voltaje flotación F1 (V)", "required": false, "unit": "V"},
          {"id": "voltaje_flotacion_f2", "type": "decimal", "label": "Voltaje flotación F2 (V)", "required": false, "unit": "V"},
          {"id": "voltaje_flotacion_f3", "type": "decimal", "label": "Voltaje flotación F3 (V)", "required": false, "unit": "V"},
          {"id": "voltaje_salida_ff", "type": "decimal", "label": "Voltaje salida F-F (V)", "required": false, "unit": "V"},
          {"id": "corriente_salida_f1", "type": "decimal", "label": "Corriente salida F1 (A)", "required": false, "unit": "A"},
          {"id": "corriente_salida_f2", "type": "decimal", "label": "Corriente salida F2 (A)", "required": false, "unit": "A"},
          {"id": "corriente_salida_f3", "type": "decimal", "label": "Corriente salida F3 (A)", "required": false, "unit": "A"},
          {"id": "porcentaje_carga", "type": "decimal", "label": "Porcentaje de carga (%)", "required": false, "unit": "%"},
          {"id": "hz_salida", "type": "decimal", "label": "HZ salida", "required": false, "unit": "Hz"},
          {"id": "queda_funcionando", "type": "boolean", "label": "¿Queda funcionando?", "required": true},
          {"id": "limpieza_equipo", "type": "select", "label": "Limpieza del equipo", "required": false, "options": ["Realizada", "No realizada", "Parcial"]},
          {"id": "limpieza_baterias", "type": "select", "label": "Limpieza de baterías", "required": false, "options": ["Realizada", "No realizada", "Parcial"]},
          {"id": "soporte_equipo_carga", "type": "select", "label": "Soporte del equipo con carga", "required": false, "options": ["Soporta", "No soporta", "Parcial"]},
          {"id": "bypass_equipo", "type": "select", "label": "Bypass del equipo", "required": false, "options": ["Funciona", "No funciona", "No aplica"]},
          {"id": "estado_final", "type": "textarea", "label": "Estado final del equipo", "required": false}
        ]
      },
      {
        "id": "causas_correctivo",
        "title": "Causas del Correctivo",
        "order": 6,
        "fields": [
          {
            "id": "causas",
            "type": "multiSelect",
            "label": "Causas del correctivo",
            "required": false,
            "options": [
              "Breakers", "Bypass externo", "Bypass interno",
              "Cargador (control)", "Cargador (potencial)",
              "Inversor (control)", "Inversor (potencial)",
              "Baterías", "Ventiladores", "Externo", "Otros"
            ]
          },
          {"id": "descripcion_causa", "type": "textarea", "label": "Descripción detallada de la causa", "required": false}
        ]
      },
      {
        "id": "informe_baterias",
        "title": "Informe de Baterías",
        "order": 7,
        "fields": [
          {"id": "marca_bateria", "type": "text", "label": "Marca", "required": false},
          {"id": "referencia_bateria", "type": "text", "label": "Referencia", "required": false},
          {"id": "cantidad_baterias", "type": "number", "label": "Cantidad", "required": false},
          {"id": "voltaje_bateria", "type": "decimal", "label": "Voltaje (V)", "required": false, "unit": "V"},
          {"id": "ah_bateria", "type": "decimal", "label": "AH", "required": false, "unit": "Ah"},
          {"id": "estacionaria", "type": "boolean", "label": "¿Estacionaria?", "required": false},
          {"id": "selladas", "type": "boolean", "label": "¿Selladas?", "required": false},
          {"id": "estado_bateria", "type": "select", "label": "Estado", "required": false, "options": ["Bueno", "Regular", "Deficiente", "Requiere cambio"]},
          {"id": "no_bancos", "type": "number", "label": "No. de Bancos", "required": false},
          {"id": "conexiones_bateria", "type": "text", "label": "Conexiones", "required": false},
          {"id": "estado_bornes", "type": "select", "label": "Estado de bornes", "required": false, "options": ["Bueno", "Regular", "Oxidado", "Requiere limpieza"]}
        ]
      },
      {
        "id": "trabajo_observaciones",
        "title": "Trabajo Realizado y Observaciones",
        "order": 8,
        "fields": [
          {"id": "trabajo_realizado", "type": "textarea", "label": "Describa el trabajo realizado", "required": true},
          {"id": "observaciones_recomendaciones", "type": "textarea", "label": "Observaciones técnicas / Recomendaciones", "required": false},
          {"id": "hora_entrada", "type": "time", "label": "Hora de entrada", "required": false},
          {"id": "hora_salida", "type": "time", "label": "Hora de salida", "required": false},
          {"id": "nombre_ingeniero", "type": "text", "label": "Nombre del Ingeniero/Técnico", "required": true},
          {"id": "nombre_cliente_firma", "type": "text", "label": "Nombre y Sello del Cliente", "required": false},
          {"id": "revisado_por", "type": "text", "label": "Revisado por", "required": false}
        ]
      }
    ]
  },
  {
    "id": "infraestructura_v1",
    "name": "Inspección de Infraestructura",
    "visit_type": "infraestructura",
    "version": 1,
    "sections": [
      {
        "id": "general",
        "title": "Información General",
        "order": 0,
        "fields": [
          {"id": "ubicacion", "type": "text", "label": "Ubicación exacta", "required": true, "hint": "Descripción detallada del sitio"},
          {"id": "descripcion", "type": "textarea", "label": "Descripción general", "required": true},
          {"id": "acceso", "type": "select", "label": "Tipo de acceso", "required": true, "options": ["Libre", "Controlado", "Restringido", "Con escolta"]},
          {"id": "condicion_sitio", "type": "select", "label": "Condición del sitio", "required": true, "options": ["Excelente", "Bueno", "Regular", "Deficiente", "Crítico"]}
        ]
      },
      {
        "id": "medidas",
        "title": "Medidas y Dimensiones",
        "order": 1,
        "fields": [
          {"id": "largo", "type": "decimal", "label": "Largo (m)", "required": false, "unit": "m"},
          {"id": "ancho", "type": "decimal", "label": "Ancho (m)", "required": false, "unit": "m"},
          {"id": "alto", "type": "decimal", "label": "Alto (m)", "required": false, "unit": "m"},
          {"id": "area_total", "type": "decimal", "label": "Área total (m²)", "required": false, "unit": "m²"}
        ]
      },
      {
        "id": "observaciones",
        "title": "Observaciones",
        "order": 2,
        "fields": [
          {"id": "observaciones_generales", "type": "textarea", "label": "Observaciones generales", "required": false},
          {"id": "requiere_intervencion", "type": "boolean", "label": "¿Requiere intervención inmediata?", "required": true},
          {"id": "prioridad", "type": "select", "label": "Prioridad", "required": false, "options": ["Baja", "Media", "Alta", "Urgente"]}
        ]
      }
    ]
  },
  {
    "id": "energia_v1",
    "name": "Inspección de Energía",
    "visit_type": "energia",
    "version": 1,
    "sections": [
      {
        "id": "instalacion",
        "title": "Datos de la Instalación",
        "order": 0,
        "fields": [
          {"id": "tipo_instalacion", "type": "select", "label": "Tipo de instalación", "required": true, "options": ["Residencial", "Comercial", "Industrial", "Corporativa"]},
          {"id": "voltaje_entrada", "type": "decimal", "label": "Voltaje de entrada (V)", "required": true, "unit": "V"},
          {"id": "voltaje_salida", "type": "decimal", "label": "Voltaje de salida (V)", "required": false, "unit": "V"},
          {"id": "corriente_nominal", "type": "decimal", "label": "Corriente nominal (A)", "required": false, "unit": "A"},
          {"id": "frecuencia", "type": "select", "label": "Frecuencia", "required": false, "options": ["50 Hz", "60 Hz"]},
          {"id": "fases", "type": "select", "label": "Número de fases", "required": true, "options": ["Monofásico", "Bifásico", "Trifásico"]}
        ]
      },
      {
        "id": "estado",
        "title": "Estado del Sistema",
        "order": 1,
        "fields": [
          {"id": "estado_tablero", "type": "select", "label": "Estado del tablero eléctrico", "required": true, "options": ["Bueno", "Regular", "Deficiente", "Requiere reemplazo"]},
          {"id": "tiene_tierra", "type": "boolean", "label": "¿Tiene puesta a tierra?", "required": true},
          {"id": "tiene_protecciones", "type": "boolean", "label": "¿Tiene protecciones (breakers/fusibles)?", "required": true},
          {"id": "tiene_polo_neutro", "type": "boolean", "label": "¿Tiene polo neutro?", "required": false},
          {"id": "tipo_cable", "type": "select", "label": "Tipo de cable predominante", "required": false, "options": ["Thhn", "Thw", "NMB", "Concéntrico", "Otro"]}
        ]
      },
      {
        "id": "observaciones",
        "title": "Observaciones",
        "order": 2,
        "fields": [
          {"id": "anomalias", "type": "textarea", "label": "Anomalías detectadas", "required": false},
          {"id": "observaciones_tecnicas", "type": "textarea", "label": "Observaciones técnicas", "required": false},
          {"id": "requiere_intervencion", "type": "boolean", "label": "¿Requiere intervención?", "required": true}
        ]
      }
    ]
  },
  {
    "id": "datos_v1",
    "name": "Inspección de Datos / Red",
    "visit_type": "datos",
    "version": 1,
    "sections": [
      {
